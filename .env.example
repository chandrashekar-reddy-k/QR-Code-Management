# ==============================================================================
# VillagKart Partner API — Environment Configuration Template
# Copy this file to .env and fill in your values.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3004
NODE_ENV=production
FRONTEND_URL=https://hub.villagkart.com,http://localhost:8080,https://admin.villagkart.com,http://localhost:7070

# ── Database (Supabase PostgreSQL via Prisma) ─────────────────────────────────
DATABASE_URL="postgresql://ecommerce:jh070BbRbn4HpzYt@139.59.28.84:5432/ecommerce?connection_limit=10"
DIRECT_URL="postgresql://ecommerce:jh070BbRbn4HpzYt@139.59.28.84:5432/ecommerce"

# ── JWT (RSA key pair — generate with: node generateKeys.js) ─────────────────
# Either set the key content directly OR place files at keys/private.key + keys/public.key
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=keys/private.key
JWT_PUBLIC_KEY_PATH=keys/public.key
JWT_EXPIRES_IN=24h

# ── OTP / Auth ────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_COOLDOWN_MINUTES=2
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_MINUTES=1

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=30s
RATE_LIMIT_MAX=10000

# ── Redis (for idempotency / real-time fanout) ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AWS S3 (for file uploads) ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAUHRHI7XJELWYRWHM
AWS_SECRET_ACCESS_KEY=jwnm06ldXt2VQdT/ZmlHCEUl0/aP8K9hJeWllS2WA
AWS_REGION=ap-south-1
S3_BUCKET_NAME=dev-villagkart-media

# ── Firebase Admin (push notifications) ──────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_FILE=run/secrets/firebase-adminsdk.json

# ── Razorpay (payments) ───────────────────────────────────────────────────────
