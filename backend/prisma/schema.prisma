  refillsTo          InventoryRefillRequest[] @relation("RefillToLocation")
  reservations       InventoryReservation[]
  stockLedgerEntries StockLedger[]
  transfersFrom      StockTransfer[]          @relation("FromLocationTransfers")
  transfersTo        StockTransfer[]          @relation("ToLocationTransfers")
