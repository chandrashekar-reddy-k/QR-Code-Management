// -----------------------------------------------------------------------------
// QR Studio additions (additive, no impact on existing models)
// -----------------------------------------------------------------------------

enum QRCodeType {
  STATIC
  DYNAMIC
}

enum RoutingBehavior {
  REDIRECT
  DEEP_LINK
  WEB_VIEW
}

model QRCode {
  id              String           @id @default(uuid())
  name            String
  status          String           @default("ACTIVE")
  type            QRCodeType       @default(STATIC)
  destinationUrl  String
  fallbackUrl     String?
  androidUrl      String?
  iosUrl          String?
  routingBehavior RoutingBehavior  @default(REDIRECT)
  designJson      Json
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ownerId         String?
  warehouseId     String?
  // relations
  owner           User?            @relation(fields: [ownerId], references: [id])
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id])
  versions        QRCodeVersion[]
  scans           QRScanEvent[]
  approvals       QRCodeApproval[]
  assets          QRCodeAsset[]

  @@index([ownerId])
  @@index([warehouseId])
}

model QRCodeVersion {
  id            String   @id @default(uuid())
  qrCodeId      String
  versionNumber Int      @default(1)
  designJson    Json
  updatedAt     DateTime @default(now())

  qrCode QRCode @relation(fields: [qrCodeId], references: [id])

  @@unique([qrCodeId, versionNumber])
}

model QRScanEvent {
  id                  String   @id @default(uuid())
  qrCodeId            String
  scannedAt           DateTime @default(now())
  userId              String?
  deviceInfoJson      Json?
  conversionTriggered Boolean  @default(false)

  qrCode QRCode @relation(fields: [qrCodeId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([qrCodeId])
  @@index([userId])
}

model QRCodeApproval {
  id         String    @id @default(uuid())
  qrCodeId   String
  approverId String
  status     String    @default("PENDING")
  remarks    String?
  approvedAt DateTime?

  qrCode   QRCode @relation(fields: [qrCodeId], references: [id])
  approver User   @relation(fields: [approverId], references: [id])

  @@index([qrCodeId])
  @@index([approverId])
}

model QRCodeAsset {
  id          String   @id @default(uuid())
  qrCodeId    String
  mediaId     String
  generatedAt DateTime @default(now())
  assetType   String   @default("PNG")

  qrCode QRCode @relation(fields: [qrCodeId], references: [id])
  media  Media  @relation(fields: [mediaId], references: [id])

  @@index([qrCodeId])
  @@index([mediaId])
}
