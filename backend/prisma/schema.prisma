model RouteSchedule {
  id             String   @id @default(uuid())
  routeId        String
  scheduledDate  DateTime @db.Date
  startTime      String?
  endTime        String?
  assignedUserId String?
  status         String   @default("SCHEDULED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedUser   User?    @relation(fields: [assignedUserId], references: [id])
  route          Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, scheduledDate])
  @@index([routeId])
}

model RouteExecution {
  id             String    @id @default(uuid())
  routeId        String
  driverId       String
  vehicleId      String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  startOdometer  Float
  endOdometer    Float?
  status         String    @default("IN_PROGRESS")
  cashCollected  Float     @default(0)
  upiCollected   Float     @default(0)
  expensesAmount Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  driver         User      @relation(fields: [driverId], references: [id])
  route          Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])

  @@index([routeId])
  @@index([driverId])
  @@index([vehicleId])
}

model VillageDemandForecast {
  id            String   @id @default(uuid())
  villageId     String
  productId     String
  forecastDate  DateTime @db.Date
  forecastedQty Float
  confidence    Float    @default(1.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  village       Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([villageId, productId, forecastDate])
  @@index([villageId])
  @@index([productId])
}

model Settlement {
  id                 String            @id @default(uuid())
  orderId            String
  fulfillmentOrderId String?
  party              SettlementParty
  partyId            String
  amount             Float
  status             SettlementStatus  @default(PENDING)
  processedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  fulfillmentOrder   FulfillmentOrder? @relation(fields: [fulfillmentOrderId], references: [id])
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([fulfillmentOrderId])
  @@index([partyId])
}

model FulfillmentSLA {
  id                 String           @id @default(uuid())
  fulfillmentOrderId String           @unique
  allocatedAt        DateTime         @default(now())
  packedAt           DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  slaLimitMinutes    Int
  isBreached         Boolean          @default(false)
  warningSent        Boolean          @default(false)
  createdAt          DateTime         @default(now())
  fulfillmentOrder   FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
}

model CommissionRule {
  id                String  @id @default(uuid())
  partyType         String
  partyId           String?
  commissionPercent Float
  fixedFee          Float   @default(0)
  isActive          Boolean @default(true)
}

model OmsAuditLog {
  id         String   @id @default(uuid())
  orderId    String
  entityType String
  oldValue   Json?
  newValue   Json?
  changedBy  String?
  createdAt  DateTime @default(now())
}

model BusinessRule {
  id        String   @id @default(uuid())
  name      String
  ruleKey   String   @unique
  ruleValue String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DashboardMetrics {
  id          String   @id @default(uuid())
  metricKey   String   @unique
  metricValue Float
  updatedAt   DateTime @updatedAt
}

model PriceBook {
  id        String         @id @default(uuid())
  name      String
  code      String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  partnerId String?
  prices    ProductPrice[]

  @@unique([code, partnerId])
  @@index([code])
  @@index([partnerId])
}

model ProductPrice {
  id               String          @id @default(uuid())
  productId        String
  priceBookId      String
  mrp              Float
  sellingPrice     Float
  effectiveFrom    DateTime        @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  productVariantId String?
  priceBook        PriceBook       @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productId, priceBookId])
  @@index([productVariantId, priceBookId])
}

model Shopkeeper {
  id               String     @id @default(uuid())
  name             String
  employeeId       String?
  phone            String?
  status           String     @default("Available")
  activeOrderCount Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  warehouseId      String?
  Warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
}

model PackingTray {
  id             String     @id @default(uuid())
  trayNumber     String     @unique
  warehouseId    String?
  isActive       Boolean    @default(false)
  currentOrderId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  currentOrder   Order?     @relation("TrayOrder", fields: [currentOrderId], references: [id])
  warehouse      Warehouse? @relation(fields: [warehouseId], references: [id])
}

model SlaLog {
  id           String    @id @default(uuid())
  orderId      String
  event        String
  expectedTime DateTime?
  actualTime   DateTime?
  breach       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  order        Order     @relation(fields: [orderId], references: [id])
}

model Rack {
  id          String    @id @default(uuid())
  name        String
  warehouseId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  code        String?
  isActive    Boolean   @default(true)
  maxShelves  Int?
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  shelves     Shelf[]

  @@unique([warehouseId, name])
}

model Shelf {
  id        String   @id @default(uuid())
  name      String
  rackId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rack      Rack     @relation(fields: [rackId], references: [id], onDelete: Cascade)
  trays     Tray[]

  @@unique([rackId, name])
}

model Tray {
  id               String            @id @default(uuid())
  name             String
  shelfId          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  capacity         Int?
  productLocations ProductLocation[]
  shelf            Shelf             @relation(fields: [shelfId], references: [id], onDelete: Cascade)

  @@unique([shelfId, name])
}

model ProductLocation {
  id               String          @id @default(uuid())
  productId        String
  productVariantId String?
  trayId           String
  warehouseId      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  quantity         Int             @default(0)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  tray             Tray            @relation(fields: [trayId], references: [id], onDelete: Cascade)
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId, productVariantId])
}

model ConsumerSubscription {
  id           String   @id
  userId       String
  productId    String
  quantity     Int      @default(1)
  frequency    String
  status       String   @default("ACTIVE")
  nextDelivery DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Product      Product  @relation(fields: [productId], references: [id])
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LocationWaitlist {
  id           String    @id
  mobileNumber String
  pincode      String
  status       String    @default("PENDING")
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@unique([mobileNumber, pincode])
  @@index([pincode])
  @@index([status])
}

model ProductTierPrice {
  id               String          @id @default(uuid())
  productId        String
  productVariantId String?
  minQuantity      Int
  maxQuantity      Int?
  price            Float
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productVariantId])
}

model SavedPaymentMethod {
  id             String      @id
  userId         String
  methodType     PaymentMode
  provider       String?
  maskedNumber   String?
  expiryMonth    String?
  expiryYear     String?
  cardholderName String?
  upiId          String?
  gatewayToken   String?
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime
  User           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

model Translation {
  id           String   @id
  entityType   String
  entityId     String
  language     String
  translations Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@unique([entityType, entityId, language])
  @@index([entityType, entityId, language])
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model AgentStockTransfer {
  id            String                   @id @default(uuid())
  tenantId      String                   @default("VK001")
  fromVehicleId String
  toVehicleId   String
  fromUserId    String
  toUserId      String
  remarks       String?
  status        String                   @default("PENDING")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  storeId       String?
  fromUser      User                     @relation("FromUserTransfers", fields: [fromUserId], references: [id])
  fromVehicle   Vehicle                  @relation("FromVehicleTransfers", fields: [fromVehicleId], references: [id])
  Warehouse     Warehouse?               @relation(fields: [storeId], references: [id])
  toUser        User                     @relation("ToUserTransfers", fields: [toUserId], references: [id])
  toVehicle     Vehicle                  @relation("ToVehicleTransfers", fields: [toVehicleId], references: [id])
  items         AgentStockTransferItem[]

  @@index([fromUserId])
  @@index([toUserId])
  @@index([fromVehicleId])
  @@index([toVehicleId])
  @@index([createdAt])
  @@index([status])
  @@index([storeId])
  @@index([tenantId])
}

model AgentStockTransferItem {
  id         String             @id @default(uuid())
  transferId String
  productId  String
  quantity   Int
  product    Product            @relation(fields: [productId], references: [id])
  transfer   AgentStockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
}

model AgentTransferApproval {
  id         String   @id @default(uuid())
  transferId String
  status     String
  remarks    String?
  userId     String
  createdAt  DateTime @default(now())

  @@index([transferId])
  @@index([userId])
}

model SecurityVerificationLog {
  id        String   @id @default(uuid())
  name      String
  mobile    String
  email     String?
  role      String
  ipAddress String
  otpCode   String?
  status    String   @default("VERIFIED")
  createdAt DateTime @default(now())
}

model StoreroomStock {
  id            String   @id @default(uuid())
  productId     String   @unique
  warehouseId   String?
  rawStock      Int      @default(0)
  inwardBatchNo String?
  qualityStatus String   @default("PENDING_GRADING")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([qualityStatus])
}

model ProductionStock {
  id              String   @id @default(uuid())
  productId       String   @unique
  warehouseId     String?
  inProductionQty Int      @default(0)
  packedQty       Int      @default(0)
  batchNumber     String?
  processingStage String   @default("GRADING_PACKING")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([processingStage])
}

model LiveStockChannel {
  id            String   @id @default(uuid())
  productId     String   @unique
  warehouseId   String?
  liveAvailable Int      @default(0)
  isOnline      Boolean  @default(true)
  isPos         Boolean  @default(true)
  isVehicle     Boolean  @default(true)
  channelNotes  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isOnline, isPos, isVehicle])
  @@index([warehouseId])
}

model OnlineAppStock {
  id          String   @id @default(uuid())
  productId   String   @unique
  warehouseId String?
  appPrice    Float?
  onlineStock Int      @default(0)
  minOrderQty Int      @default(1)
  maxOrderQty Int      @default(50)
  isPublished Boolean  @default(true)
  badge       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isPublished])
  @@index([warehouseId])
}

model PosStoreStock {
  id            String   @id @default(uuid())
  productId     String   @unique
  warehouseId   String?
  posPrice      Float?
  posStock      Int      @default(0)
  barcode       String?
  shelfLocation String?
  taxRate       Float    @default(5)
  isPosEnabled  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([barcode])
  @@index([isPosEnabled])
  @@index([warehouseId])
}

model InventoryStageTransfer {
  id            String   @id @default(uuid())
  productId     String
  warehouseId   String?
  fromStage     String
  toStage       String
  quantity      Int
  notes         String?
  performedById String?
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([fromStage, toStage])
}

model UnitOfMeasure {
  id           String   @id @default(uuid())
  name         String   @unique
  abbreviation String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean  @default(true)
}

model Inventory {
  id          String    @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

model StorageLocation {
  id          String    @id @default(uuid())
  name        String
  warehouseId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}

model Recipe {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String
  outputProductId String
  outputQty       Float
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  workOrders      WorkOrder[]
  outputProduct   Product      @relation("RecipeOutput", fields: [outputProductId], references: [id])
  items           RecipeItem[]
}

model RecipeItem {
  id             String   @id @default(uuid())
  recipeId       String
  inputProductId String
  requiredQty    Float
  tolerancePct   Float    @default(0)
  isPackaging    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  inputProduct   Product  @relation(fields: [inputProductId], references: [id])
  recipe         Recipe   @relation(fields: [recipeId], references: [id])
}

model WorkOrder {
  id                String                 @id @default(uuid())
  woNumber          String                 @unique
  productId         String
  recipeId          String?
  status            WoStatus               @default(DRAFT)
  priority          WoPriority             @default(MEDIUM)
  requiredQty       Float
  actualProduced    Float?
  actualRejected    Float?
  batchNumber       String?                @unique
  supervisorId      String
  expectedDate      DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  inspectorId       String?
  isPaused          Boolean                @default(false)
  operatorId        String?
  pauseReason       String?
  labelsPrinted     Float                  @default(0)
  labelsApplied     Float                  @default(0)
  warehouseId       String?
  sourceItems       Json?
  outputAllocations Json?
  remarks           String?
  finishedGoods     FinishedGoods[]
  reportedIssues    Issue[]
  labelTasks        LabelApplicationTask[]
  LabelPrintJob     LabelPrintJob[]
  materialIssues    MaterialIssue[]
  inspector         User?                  @relation("InspectorAssigned", fields: [inspectorId], references: [id])
  operator          User?                  @relation("OperatorAssigned", fields: [operatorId], references: [id])
  product           Product                @relation(fields: [productId], references: [id])
  recipe            Recipe?                @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  supervisor        User                   @relation(fields: [supervisorId], references: [id])
  warehouse         Warehouse?             @relation(fields: [warehouseId], references: [id])
  qualityChecks     QualityCheck[]
  repackingLogs     RepackingLog[]

  @@map("PackingWorkOrder")
}

model MaterialIssue {
  id         String      @id @default(uuid())
  issueNo    String      @unique
  woId       String
  issuedById String
  status     IssueStatus @default(PENDING)
  payload    Json
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  issuedBy   User        @relation(fields: [issuedById], references: [id])
  workOrder  WorkOrder   @relation(fields: [woId], references: [id])
}

model QualityCheck {
  id            String      @id @default(uuid())
  qcNumber      String      @unique
  woId          String
  inspectorId   String
  checkedQty    Float
  result        QcResult
  severity      QcSeverity?
  failureReason String?
  remarks       String?
  checksPayload Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  inspector     User        @relation(fields: [inspectorId], references: [id])
  workOrder     WorkOrder   @relation(fields: [woId], references: [id])
}

model FinishedGoods {
  id          String    @id @default(uuid())
  fgNumber    String    @unique
  woId        String
  productId   String
  batchNumber String
  postedQty   Float
  destination String
  costPayload Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id])
  workOrder   WorkOrder @relation(fields: [woId], references: [id])
}

model RepackingLog {
  id                 String    @id @default(uuid())
  rpNumber           String    @unique
  sourceWoId         String
  repackType         String
  recoverableQty     Float
  wasteQty           Float
  newBatchNumber     String?
  targetRecipeId     String?
  loggedById         String
  status             String    @default("REPACKING_PENDING")
  remarks            String?
  requiresRelabeling Boolean   @default(false)
  operatorId         String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sourceWorkOrder    WorkOrder @relation(fields: [sourceWoId], references: [id])
}

model ApprovalRequest {
  id                String            @id @default(uuid())
  type              ApprovalType
  relatedEntityId   String
  relatedEntityName String
  requestedById     String
  requestedDate     DateTime          @default(now())
  reason            String
  priority          Priority
  status            ApprovalStatus    @default(PENDING)
  existingValues    Json?
  proposedValues    Json?
  remarks           String?
  attachments       String[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  history           ApprovalHistory[]
  requestedBy       User              @relation("RequestedApprovals", fields: [requestedById], references: [id])
}

model ApprovalHistory {
  id                String          @id @default(uuid())
  approvalRequestId String
  action            String
  actionById        String
  actionDate        DateTime        @default(now())
  comments          String?
  actionBy          User            @relation("ApprovalActions", fields: [actionById], references: [id])
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
}

model Issue {
  id           String     @id @default(uuid())
  type         IssueType
  description  String
  photoUrls    String[]   @default([])
  woId         String?
  reportedById String
  status       String     @default("OPEN")
  priority     Priority   @default(MEDIUM)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reportedBy   User       @relation("ReportedIssues", fields: [reportedById], references: [id])
  workOrder    WorkOrder? @relation(fields: [woId], references: [id])
}

model LabelPrintJob {
  id            String                 @id @default(uuid())
  workOrderId   String
  batchNumber   String
  barcodeType   String
  printedQty    Int
  printedById   String
  status        String                 @default("Printed")
  reprintReason String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  labelTemplate String                 @default("Retail Label")
  printer       String                 @default("Unknown")
  type          PrintJobType           @default(INITIAL)
  labelTasks    LabelApplicationTask[]
  printedBy     User                   @relation(fields: [printedById], references: [id])
  workOrder     WorkOrder              @relation(fields: [workOrderId], references: [id])
}

model LabelApplicationTask {
  id                String        @id @default(uuid())
  woId              String
  printJobId        String
  operatorId        String
  assignedById      String
  requiredQuantity  Float
  appliedQuantity   Float         @default(0)
  remainingQuantity Float
  status            TaskStatus    @default(ASSIGNED)
  assignedAt        DateTime      @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  assignedBy        User          @relation("TasksAssignedBy", fields: [assignedById], references: [id])
  operator          User          @relation("AssignedTasks", fields: [operatorId], references: [id])
  printJob          LabelPrintJob @relation(fields: [printJobId], references: [id])
  workOrder         WorkOrder     @relation(fields: [woId], references: [id])
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  theme              String   @default("light")
  emailNotifications Boolean  @default(true)
  inAppNotifications Boolean  @default(true)
  compactView        Boolean  @default(false)
  autoPrintLabels    Boolean  @default(false)
  defaultPrinter     String?  @default("Zebra-ZT230")
  language           String   @default("en")
  timezone           String   @default("UTC")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PreOrder {
  id                   String                @id @default(cuid())
  preOrderNumber       String                @unique
  tenantId             String                @default("VK001")
  storeId              String?
  customerId           String?
  customerName         String
  customerMobile       String
  villageName          String?
  deliveryAddress      String?
  landmark             String?
  bookedAt             DateTime              @default(now())
  deliveryDate         DateTime
  deliverySlot         String?
  source               PreOrderSource        @default(VEHICLE_AGENT)
  bookedByAgentId      String?
  bookedFromVehicleId  String?
  bookedRouteId        String?
  assignedVehicleId    String?
  assignedRouteId      String?
  assignedAgentId      String?
  status               PreOrderStatus        @default(RECEIVED)
  cancellationReason   String?
  rescheduledDate      DateTime?
  customNotes          String?
  receiptImageUrl      String?
  hasCustomItems       Boolean               @default(false)
  estimatedTotal       Float                 @default(0)
  advanceAmount        Float                 @default(0)
  advancePaymentMode   String?
  balanceAmount        Float                 @default(0)
  paymentStatus        PreOrderPaymentStatus @default(UNPAID)
