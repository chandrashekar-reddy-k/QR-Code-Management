  agent                    User?                     @relation("AgentOrders", fields: [agentId], references: [id])
  allocatedStore           Store?                    @relation("OrderAllocatedStore", fields: [allocatedStoreId], references: [id])
  allocatedWarehouse       Warehouse?                @relation("OrderAllocatedWarehouse", fields: [allocatedWarehouseId], references: [id])
  consumer                 User                      @relation("ConsumerOrders", fields: [consumerId], references: [id])
  coupon                   Coupon?                   @relation(fields: [couponId], references: [id])
  customer                 Customer?                 @relation(fields: [customerId], references: [id])
  deliverySlotRef          DeliverySlot?             @relation(fields: [deliverySlotId], references: [id])
  mobileStore              MobileStore?              @relation(fields: [mobileStoreId], references: [id])
  pickupSlotRef            PickupSlot?               @relation(fields: [pickupSlotId], references: [id])
  pickupStore              Warehouse?                @relation("PickupStore", fields: [pickupStoreId], references: [id])
  route                    Route?                    @relation(fields: [routeId], references: [id])
  routeMap                 RouteMap?                 @relation(fields: [routeMapId], references: [id])
  scheduledSlotRef         ScheduledDeliverySlot?    @relation(fields: [scheduledSlotId], references: [id])
  vehicle                  Vehicle?                  @relation(fields: [vehicleId], references: [id])
  warehouse                Warehouse?                @relation(fields: [warehouseId], references: [id])
  orderCancellation        OrderCancellation?
  items                    OrderItem[]
  modifications            OrderModification[]
  orderOtps                OrderOtp[]
  orderRatings             OrderRating[]
  orderReturnHistory       OrderReturnHistory[]
  statusHistory            OrderStatusHistory[]
  trackingEvents           OrderTrackingEvent[]
  packingTrays             PackingTray[]             @relation("TrayOrder")
  payment                  Payment?
  paymentTransactions      PaymentTransaction[]
  refundTransactions       RefundTransaction[]
  returns                  Return[]
  returnRequests           ReturnRequest[]
  riskAssessment           RiskAssessment?
  settlements              Settlement[]
  slaLogs                  SlaLog[]

  @@index([agentId, status])
  @@index([consumerId, status])
  @@index([consumerId, createdAt])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([couponCode])
  @@index([deliverySlotId])
  @@index([cartType])
  @@index([warehouseId, deliveryDate, deliverySlot])
  @@index([customerId])
  @@index([agentId])
  @@index([routeId])
  @@index([status])
  @@index([vehicleId])
}

/// Fulfillment OTP (pickup vs delivery). Plain OTP is never stored; only otpHash.
model OrderOtp {
  id          String       @id @default(uuid())
  orderId     String
  type        OrderOtpType
  otpHash     String
  expiresAt   DateTime
  attempts    Int          @default(0)
  resendCount Int          @default(0)
  lastSentAt  DateTime     @default(now())
  isVerified  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type, isVerified])
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  productId          String
  productVariantId   String?
  quantity           Int
  unit               StandardUnits   @default(PIECE)
  unitPrice          Float
  totalPrice         Float
  discount           Float           @default(0)
  hsnCode            String?
  mrp                Float?
  productImage       String?
  productName        String?
  taxAmount          Float           @default(0)
  cgst               Float           @default(0)
  igst               Float           @default(0)
  sgst               Float           @default(0)
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?
  isCancelled        Boolean         @default(false)
  isPicked           Boolean         @default(false)
  isRejected         Boolean         @default(false)
  isVerified         Boolean         @default(false)
  pickedQty          Int             @default(0)
  rejectReason       String?
  rejectRemarks      String?
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
