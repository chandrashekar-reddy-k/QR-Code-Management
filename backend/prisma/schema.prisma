  productVariant     ProductVariant? @relation(fields: [productVariantId], references: [id])
  returns            Return[]

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@index([isCancelled])
  @@index([unit])
}

model Payment {
  id                 String                 @id @default(uuid())
