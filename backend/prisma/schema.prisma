  igst                     Float                     @default(0)
  sgst                     Float                     @default(0)
  taxAmount                Float                     @default(0)
  taxableAmount            Float                     @default(0)
  deliveryDistance         Float?
  deliveryType             DeliveryType?
  fastDeliveryETA          Int?
  pickupStoreId            String?
  pickupTimeSlot           String?
  assignedAt               DateTime?
  pickedUpAt               DateTime?
  deliveredAt              DateTime?
  failureReason            String?
  otpExpiresAt             DateTime?
  pickupSlotId             String?
  routeMapId               String?
  scheduledSlotId          String?
  cartType                 CartType                  @default(SINGLE)
  assignmentDueAt          DateTime?
  assignmentAcknowledgedAt DateTime?
  customerId               String?
  routeId                  String?
  vehicleId                String?
  paymentMode              PaymentMode?
  cashAmount               Float?                    @default(0)
  upiAmount                Float?                    @default(0)
  fulfillmentType          FulfillmentType           @default(HOME_DELIVERY)
  mobileStoreId            String?
  orderType                OrderType                 @default(ONLINE)
  sourceOrderId            String?
  paymentStatus            String                    @default("PENDING")
  paymentMethod            String?
  transactionId            String?
  allocatedWarehouseId     String?
  allocatedStoreId         String?
  acceptedByShopkeeperAt   DateTime?
  allocationAttempts       Int?                      @default(0)
  allocationStartedAt      DateTime?
  allocationStatus         String?                   @default("Pending")
  allocationTimeoutMinutes Int?                      @default(5)
  assignedShopkeeperId     String?
  packerId                 String?
  packingCompletedAt       DateTime?
  packingStartedAt         DateTime?
  pickerId                 String?
  pickingCompletedAt       DateTime?
  pickingStartedAt         DateTime?
  priority                 String?                   @default("MEDIUM")
  shopkeeperAcceptedAt     DateTime?
  slaBreach                Boolean                   @default(false)
  slaMinutes               Int?                      @default(30)
  trayNumber               String?
  version                  Int                       @default(1)
