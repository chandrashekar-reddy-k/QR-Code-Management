  orderId       String
  eventType     SyncEventType
  payload       Json
  retryCount    Int              @default(0)
  lastAttemptAt DateTime?
  status        FailedSyncStatus @default(PENDING)
  createdAt     DateTime         @default(now())

  @@index([status, createdAt])
  @@index([orderId, status])
}

model AuditLog {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  service        AuditService
  env            String             @db.VarChar(32)
  eventName      String             @db.VarChar(128)
  eventCategory  AuditEventCategory
  severity       AuditSeverity
  requestId      String?            @db.VarChar(128)
  eventId        String             @db.VarChar(128)
  idempotencyKey String             @unique(map: "uq_auditlog_idempotency_key") @db.VarChar(191)
  parentEventId  String?            @db.VarChar(128)
  origin         AuditOrigin
  entityType     String             @db.VarChar(64)
  entityId       String             @db.VarChar(64)
  payload        Json?
  beforeJson     Json?
  afterJson      Json?
  diffJson       Json?

  @@index([createdAt], map: "idx_auditlog_created_at")
  @@index([service, createdAt], map: "idx_auditlog_service_created")
  @@index([eventName, createdAt], map: "idx_auditlog_event_created")
  @@index([entityType, entityId, createdAt], map: "idx_auditlog_entity_created")
  @@index([requestId], map: "idx_auditlog_request_id")
  @@index([eventId], map: "idx_auditlog_event_id")
}

model AuditOutbox {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  availableAt    DateTime           @default(now()) @db.Timestamptz(6)
  processedAt    DateTime?          @db.Timestamptz(6)
  claimedAt      DateTime?          @db.Timestamptz(6)
  leaseUntil     DateTime?          @db.Timestamptz(6)
  status         OutboxStatus       @default(PENDING)
  retryCount     Int                @default(0)
  maxRetries     Int                @default(12)
  lastError      String?
  eventId        String             @db.VarChar(128)
  idempotencyKey String             @unique(map: "uq_auditoutbox_idempotency_key") @db.VarChar(191)
  service        AuditService
  eventName      String             @db.VarChar(128)
  eventCategory  AuditEventCategory
  severity       AuditSeverity
  origin         AuditOrigin
  entityType     String             @db.VarChar(64)
  entityId       String             @db.VarChar(64)
  requestId      String?            @db.VarChar(128)
  parentEventId  String?            @db.VarChar(128)
  payload        Json?
  beforeJson     Json?
  afterJson      Json?
  diffJson       Json?

  @@index([status, availableAt], map: "idx_auditoutbox_status_available")
  @@index([service, status, availableAt], map: "idx_auditoutbox_service_status_available")
  @@index([createdAt], map: "idx_auditoutbox_created")
  @@index([eventId], map: "idx_auditoutbox_event_id")
  @@index([status, leaseUntil], map: "idx_auditoutbox_status_lease")
}

model Category {
