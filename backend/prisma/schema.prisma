generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String                    @id @default(uuid())
  phone                        String                    @unique
  role                         UserRole                  @default(CONSUMER)
  name                         String?
  email                        String?                   @unique
  password                     String?
  avatar                       String?
  vehicleType                  VehicleType?
  licensePlate                 String?
  isOnline                     Boolean                   @default(false)
  currentLocation              Json?
  isActive                     Boolean                   @default(true)
  isVerified                   Boolean                   @default(false)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  lastActive                   DateTime                  @default(now())
  countryCode                  String                    @default("+91")
  bankInfo                     Json?
  emergencyContact             Json?
  region                       String?
  warehouseId                  String?
  dob                          DateTime?
  gender                       String?
  referralCode                 String?
  inviteRefCode                String?                   @unique
  bonusType                    String?
  lastLoginAt                  DateTime?
  alternatePhone               String?
  fatherOrSpouseName           String?
  maritalStatus                String?
  nationality                  String?
  surname                      String?
  lastHeartbeatAt              DateTime?
  lastBatteryPercent           Int?
  lastBatteryAlertKey          String?
  approvalStatus               ApprovalStatus            @default(PENDING)
  assignedVehicleId            String?
  shiftId                      String?
  attendanceEnabled            Boolean                   @default(true)
  baseSalary                   Float?                    @default(12000)
  customRoleId                 String?
  dailyTarget                  Float?                    @default(10000)
  kycStatus                    String                    @default("PENDING")
  vgeType                      String                    @default("EMPLOYEE")
  deliveryPreference           String?
  dietaryPreference            String?
  targetActions                ActivityLog[]             @relation("TargetActions")
  actions                      ActivityLog[]             @relation("UserActions")
  addresses                    Address[]
  agentCashCollections         AgentCashCollection[]
  fromUserTransfers            AgentStockTransfer[]      @relation("FromUserTransfers")
  toUserTransfers              AgentStockTransfer[]      @relation("ToUserTransfers")
  agentWithdrawals             AgentWithdrawal[]
  approvalActions              ApprovalHistory[]         @relation("ApprovalActions")
  requestedApprovals           ApprovalRequest[]         @relation("RequestedApprovals")
  assetAssignments             AssetAssignment[]
  assetIssues                  AssetIssue[]
  assetRequests                AssetRequest[]            @relation("UserAssetRequests")
  attendances                  Attendance[]
  bankDeposits                 BankDeposit[]
  carts                        Cart[]
  cashSessions                 CashSession[]
  cashTransfers                CashTransfer[]
  receivedChats                Chat[]                    @relation("ChatReceiver")
  sentChats                    Chat[]                    @relation("ChatSender")
  closingCash                  ClosingCash[]
  ConsumerSubscription         ConsumerSubscription[]
  couponRedemptions            CouponRedemption[]
  CycleCount                   CycleCount[]
  dailySummaries               DailyCashSummary[]        @relation("UserDailyCashSummary")
  deductionsApplied            DamageDeduction[]         @relation("DeductionApplier")
  deductionsReceived           DamageDeduction[]         @relation("DeductionTarget")
  damageReports                DamageEntry[]             @relation("DamageReporter")
  damageReviews                DamageEntry[]             @relation("DamageReviewer")
  deliveries                   Delivery[]                @relation("DeliveryAgent")
  agentBank                    DeliveryAgentBank?
  deliveryAgentDocuments       DeliveryAgentDocument[]
  agentEducations              DeliveryAgentEducation[]
  agentExperiences             DeliveryAgentExperience[]
  deliveryAssignments          DeliveryAssignment[]
  deliveryAttemptsAsAgent      DeliveryAttempt[]         @relation("DeliveryAttemptAgent")
  deliveryLocationHistory      DeliveryLocationHistory[] @relation("DeliveryLocationHistoryAgent")
  deviceMetadata               DeviceMetadata[]
  devices                      DeviceToken[]
  expenses                     Expense[]
  fulfillmentAssignments       FulfillmentAssignment[]
  GoodsReceipt                 GoodsReceipt[]
  inventoryApprovedCycleCounts InventoryCycleCount[]     @relation("UserApprovedCycleCounts")
  inventoryCycleCounts         InventoryCycleCount[]     @relation("UserCycleCounts")
  inventoryDamageEntries       InventoryDamageEntry[]    @relation("UserDamageEntries")
  inventoryLocations           InventoryLocation[]       @relation("UserLocations")
  inventoryMovements           InventoryMovement[]       @relation("UserMovements")
  approvedRefillRequests       InventoryRefillRequest[]  @relation("RefillApprover")
  refillRequests               InventoryRefillRequest[]  @relation("RefillRequester")
  inventoryReservations        InventoryReservation[]    @relation("UserReservations")
  reportedIssues               Issue[]                   @relation("ReportedIssues")
  tasksAssignedBy              LabelApplicationTask[]    @relation("TasksAssignedBy")
  assignedTasks                LabelApplicationTask[]    @relation("AssignedTasks")
  labelPrintJobs               LabelPrintJob[]
  lateEntries                  LateEntry[]
  approvedExceptions           LateEntryException[]      @relation("ApprovedBy")
  lateExceptions               LateEntryException[]      @relation("UserExceptions")
  leaveBalances                LeaveBalance[]
  locationCheckIns             LocationCheckIn[]
  locationLogs                 LocationLog[]
  materialIssues               MaterialIssue[]
  media                        Media[]
  shiftsAsDriver               MobileStoreShift[]        @relation("ShiftDriver")
  shiftsAsSalesStaff           MobileStoreShift[]        @relation("ShiftSalesStaff")
  notifications                Notification[]
  openingCash                  OpeningCash[]
  agentOrders                  Order[]                   @relation("AgentOrders")
  consumerOrders               Order[]                   @relation("ConsumerOrders")
  deliveryBoyRatings           OrderRating[]             @relation("DeliveryBoyRatings")
  orderRatings                 OrderRating[]             @relation("UserOrderRatings")
  trackingEventsAsAgent        OrderTrackingEvent[]      @relation("OrderTrackingEventAgent")
  assignedQc                   WorkOrder[]               @relation("InspectorAssigned")
  assignedWos                  WorkOrder[]               @relation("OperatorAssigned")
  workOrders                   WorkOrder[]
  assignedPreOrders            PreOrder[]                @relation("AssignedAgentPreOrders")
  bookedPreOrders              PreOrder[]                @relation("BookedByAgentPreOrders")
  qualityChecks                QualityCheck[]
  ratings                      Rating[]
  approvedRefills              RefillRequest[]           @relation("ApprovedRefills")
  vsmsRefillRequests           RefillRequest[]
  returns                      Return[]
  returnRequests               ReturnRequest[]
  routeAssignments             RouteAssignment[]
  routeExecutions              RouteExecution[]
  routeSchedules               RouteSchedule[]
  safeTransactions             SafeTransaction[]
  SavedPaymentMethod           SavedPaymentMethod[]
  sessions                     Session[]
  shiftLogs                    ShiftLog[]
  socketSessions               SocketSession[]
  stockAdjusts                 StockAdjust[]
  stockAudits                  StockAudit[]
  inventoryAuditsConducted     InventoryAudit[]          @relation("AuditorRelation")
  inventoryAuditsReviewed      InventoryAudit[]          @relation("ReviewerRelation")
  stockTransactions            StockTransaction[]        @relation("UserStockTransactions")
  StockTransfer                StockTransfer[]
  store                        Store?
  closedRegisters              StoreCashRegister[]       @relation("ClosedRegisters")
  openedRegisters              StoreCashRegister[]       @relation("OpenedRegisters")
  storeDeposits                StoreDeposit[]
  supplier                     Supplier?
  assignedVehicle              Vehicle?                  @relation("UserVehicle", fields: [assignedVehicleId], references: [id])
  shift                        Shift?                    @relation(fields: [shiftId], references: [id])
  Warehouse                    Warehouse?                @relation(fields: [warehouseId], references: [id])
  userCoupons                  UserCoupon[]
  documents                    UserDocument[]
  settings                     UserSettings?
  vehicles                     VehicleInfo[]
  vehicleDamageReports         VehiclePhysicalDamage[]   @relation("VehicleDamageReporter")
  vehicleTrips                 VehicleTrip[]
  vendorSetting                VendorSetting?
  dailyPerformance             VgeDailyPerformance[]     @relation("UserDailyPerformance")
  monthlySummaries             VgeMonthlySummary[]       @relation("UserMonthlySummary")
  villageActivities            VillageActivity[]
  wishlist                     Wishlist?                 @relation("UserWishlists")
  qrcodes                      QRCode[]
  qrscanEvents                 QRScanEvent[]
  qrcodeApprovals              QRCodeApproval[]

  @@index([phone, role])
  @@index([role, isActive, isOnline])
  @@index([assignedVehicleId])
  @@index([customRoleId])
  @@index([role])
}

model DeviceToken {
  id          String   @id @default(uuid())
  deviceToken String   @unique
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fcmToken    String?  @unique
  platform    String?
  appVersion  String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceMetadata {
  id                  String    @id @default(uuid())
  userId              String
  deviceId            String
  deviceToken         String?
  platform            String?
  deviceModel         String?
  deviceBrand         String?
  deviceManufacturer  String?
  deviceName          String?
  osName              String?
  osVersion           String?
  appVersion          String?
  buildNumber         String?
  sdkVersion          String?
  networkType         String?
  ipAddress           String?
  language            String?
  timezone            String?
  country             String?
  notificationEnabled Boolean?
  isEmulator          Boolean?
  isRooted            Boolean?
  clientUpdatedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceToken])
  @@index([updatedAt])
}

model VehicleInfo {
  id                   String              @id @default(uuid())
  agentId              String
  vehicleType          String
  brand                String
  model                String
  year                 Int
  color                String
  registrationNumber   String              @unique
  engineNumber         String              @unique
  chassisNumber        String              @unique
  insuranceProvider    String?
  policyNumber         String?
  insuranceExpiry      DateTime?
  drivingLicenseNumber String?
  licenseExpiry        DateTime?
  rcExpiry             DateTime?
  pucExpiry            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  inventoryLocations   InventoryLocation[]
  agent                User                @relation(fields: [agentId], references: [id])
  VehicleInventory     VehicleInventory[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String?  @unique
  deviceId  String?
  fcmToken  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  otp       String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Address {
  id          String      @id @default(uuid())
  userId      String
  label       String?
  line1       String
  line2       String?
  city        String
  state       String
  pincode     String
  isDefault   Boolean     @default(false)
  location    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  addressType AddressType @default(PERMANENT)
  mandal      String?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId, isDefault])
  @@index([pincode])
}

model Warehouse {
  id                         String                      @id @default(uuid())
  name                       String
  code                       String                      @unique
  location                   Json
  address                    String
  phone                      String?
  isActive                   Boolean                     @default(true)
  opensAt                    String?
  closesAt                   String?
  servicePincodes            String[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  state                      String?
  isPickupStore              Boolean                     @default(false)
  pickupTimeSlots            Json?
  onboardingStep             Int                         @default(1)
  onboardingStatus           OnboardingStatus            @default(IN_PROGRESS)
  resumeToken                String?
  resumeTokenExp             DateTime?
  fatherOrSpouseName         String?
  alternateMobileNumber      String?
  maritalStatus              String?
  educationQualification     String?
  communicationAddress       Json?
  sameAsPermanent            Boolean                     @default(false)
  approvalStatus             ApprovalStatus              @default(PENDING)
  sirName                    String?
  imageUrl                   String?
  rejectionReason            String?
  city                       String?
  clusterId                  String?
  contactNumber              String?
  managerName                String?
  pincode                    String?
  activityLogs               ActivityLog[]
  AgentStockTransfer         AgentStockTransfer[]
  assets                     Asset[]
  assetCategories            AssetCategory[]
  attendances                Attendance[]
  bankDeposits               BankDeposit[]
  banners                    Banner[]
  businessSettings           BusinessSettings?
  campaigns                  Campaign[]
  carts                      Cart[]
  cashSessions               CashSession[]
  cashTransfers              CashTransfer[]
  closingCash                ClosingCash[]
  coupons                    Coupon[]
  customers                  Customer[]
  CycleCount                 CycleCount[]
  dailySummaries             DailyCashSummary[]
  dailyCoverages             DailyCoverage[]
  damageDeductions           DamageDeduction[]
  damageEntries              DamageEntry[]
  deliveryAssignments        DeliveryAssignment[]
  deliveryChargeRules        DeliveryChargeRule[]
  deliverySlots              DeliverySlot[]
  expenses                   Expense[]
  inventories                Inventory[]
  inventoryLocations         InventoryLocation[]
  lateEntries                LateEntry[]
  lateConfigs                LateEntryConfig[]
  locationCheckIns           LocationCheckIn[]
  mobileStores               MobileStore[]
  openingCash                OpeningCash[]
  allocatedOrders            Order[]                     @relation("OrderAllocatedWarehouse")
  pickupOrders               Order[]                     @relation("PickupStore")
  orders                     Order[]
  PackingTray                PackingTray[]
  workOrders                 WorkOrder[]
  pickupSlots                PickupSlot[]
  preOrders                  PreOrder[]                  @relation("StorePreOrders")
  products                   Product[]
  ProductLocation            ProductLocation[]
  Rack                       Rack[]
  refillItems                RefillItem[]
  refillRequests             RefillRequest[]
  routes                     Route[]
  routeMaps                  RouteMap[]
  safeTransactions           SafeTransaction[]
  scheduledDeliverySlots     ScheduledDeliverySlot[]
  shiftLogs                  ShiftLog[]
  Shopkeeper                 Shopkeeper[]
  StockAdjust                StockAdjust[]
  stockAudits                StockAudit[]
  inventoryAudits            InventoryAudit[]
  stockTransactions          StockTransaction[]
  storageLocations           StorageLocation[]
  stores                     Store[]
  storeCashRegisters         StoreCashRegister[]
  storeDeposits              StoreDeposit[]
  User                       User[]
  variantInventory           VariantInventory[]
  vehicles                   Vehicle[]
  vehicleStocks              VehicleStock[]
  dailyPerformance           VgeDailyPerformance[]
  incentiveConfigs           VgeIncentiveConfig[]
  monthlySummaries           VgeMonthlySummary[]
  villages                   Village[]
  cluster                    Cluster?                    @relation(fields: [clusterId], references: [id])
  warehouseAssets            WarehouseAsset[]
  warehouseAudits            WarehouseAudit[]
  warehouseBusiness          WarehouseBusiness[]
  warehouseBusinessDocuments WarehouseBusinessDocument[]
  warehouseCapacity          WarehouseCapacity?
  warehouseCategories        WarehouseCategory[]
  deliveryBlackouts          WarehouseDeliveryBlackout[]
  warehouseDeliverySetting   WarehouseDeliverySetting?
  warehouseDocumentFiles     WarehouseDocumentFile[]
  warehouseEmployees         WarehouseEmployee[]
  warehouseLocations         WarehouseLocation[]
  warehouseReturns           WarehouseReturn[]
  slaConfig                  WarehouseSlaConfig?
  warehouseSubCategories     WarehouseSubCategory[]
  warehouseTransfers         WarehouseTransfer[]
  warehouseZones             WarehouseZone[]
  qrcodes                    QRCode[]

  @@index([isActive])
  @@index([servicePincodes])
  @@index([isPickupStore])
}

/// Configurable SLA window per warehouse. slaSeconds = hours*3600 + minutes*60.
model WarehouseSlaConfig {
  id          String    @id @default(uuid())
  warehouseId String    @unique
  slaSeconds  Int       @default(1800)
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}

/// Global default delivery types; warehouses/partners override via WarehouseDeliverySetting.
model MasterDeliverySetting {
  id                    String       @id @default(uuid())
  type                  DeliveryType @unique
  label                 String
  isEnabledByDefault    Boolean      @default(true)
  defaultCharge         Decimal      @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal?     @db.Decimal(10, 2)
  displayOrder          Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([type])
}

/// Express charge: use expressDeliveryCharge when set, else defaultDeliveryCharge (express fallback).
model WarehouseDeliverySetting {
  id                             String    @id @default(uuid())
  warehouseId                    String    @unique
  expressSettingsEnabled         Boolean   @default(false)
  selfPickupEnabled              Boolean   @default(false)
  scheduledDeliveryEnabled       Boolean   @default(false)
  defaultDeliveryCharge          Decimal?  @db.Decimal(10, 2)
  scheduledDeliveryCharge        Decimal?  @db.Decimal(10, 2)
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  expressDeliveryCharge          Decimal?  @db.Decimal(10, 2)
  expressFreeDeliveryThreshold   Decimal?  @db.Decimal(10, 2)
  scheduledFreeDeliveryThreshold Decimal?  @db.Decimal(10, 2)
  freeDeliveryThreshold          Decimal?  @db.Decimal(10, 2)
  warehouse                      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
}

model RouteMap {
  id                     String                  @id @default(uuid())
  warehouseId            String
  area                   String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deliverySlots          DeliverySlot[]
  orders                 Order[]
  warehouse              Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  routeMapPincodes       RouteMapPincode[]
  scheduledDeliverySlots ScheduledDeliverySlot[]

  @@unique([warehouseId, area])
  @@index([warehouseId])
}

model RouteMapPincode {
  id         String   @id @default(uuid())
  routeMapId String
  pincode    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  routeMap   RouteMap @relation(fields: [routeMapId], references: [id], onDelete: Cascade)

  @@unique([routeMapId, pincode])
  @@index([pincode])
  @@index([routeMapId])
}

model ScheduledDeliverySlot {
  id            String                   @id @default(uuid())
  warehouseId   String
  routeMapId    String
  slotDate      DateTime                 @db.Date
  startTime     String
  endTime       String
  ordersPerSlot Int
  isRepeat      Boolean                  @default(false)
  repeatType    ScheduledSlotRepeatType? @default(ONCE)
  customDays    String[]                 @default([])
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  orders        Order[]
  routeMap      RouteMap                 @relation(fields: [routeMapId], references: [id], onDelete: Cascade)
  warehouse     Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, routeMapId, slotDate, startTime, endTime])
  @@index([warehouseId, slotDate])
  @@index([routeMapId])
  @@index([slotDate])
}

model Supplier {
  id               String          @id @default(uuid())
  userId           String          @unique
  companyName      String
  gstin            String?
  businessAddress  Json
  licenseDocs      Json?
  operatingHours   Json?
  deliveryOptions  Json?
  GoodsReceipt     GoodsReceipt[]
  user             User            @relation(fields: [userId], references: [id])
  masterProducts   MasterProduct[] @relation("MasterSupplierProducts")
  suppliedProducts Product[]       @relation("SupplierProducts")
}

model Product {
  id                           String                         @id @default(uuid())
  name                         String
  slug                         String?
  description                  String?
  shortDescription             String?
  images                       String[]
  tags                         String[]
  brandId                      String?                        @db.Uuid
  categoryId                   String                         @db.Uuid
  subCategoryId                String?                        @db.Uuid
  productType                  String?
  inventoryType                String?
  price                        Float
  mrp                          Float?
  discountType                 String?
  discountValue                Float?
  finalPrice                   Float?
  costPrice                    Float?
  taxRate                      Float?                         @default(0)
  unitType                     String?
  unit                         String
  measurement                  String?
  warehouseId                  String?
  stock                        Int                            @default(0)
  threshold                    Int                            @default(5)
  minOrderQty                  Int?
  maxOrderQty                  Int?
  isActive                     Boolean                        @default(true)
  isFeatured                   Boolean                        @default(false)
  status                       ProductStatus                  @default(PENDING)
  variantName                  String?
  sku                          String?
  barcode                      String?
  variantStatus                Boolean                        @default(true)
  weight                       Float                          @default(0)
  metaTitle                    String?
  metaKeywords                 String?
  metaDescription              String?
  schemaMarkup                 String?
  manufacturer                 String?
  madeIn                       String?
  fssaiLicNo                   String?
  isReturnable                 Boolean                        @default(false)
  isCancelable                 Boolean                        @default(false)
  isCodAllowed                 Boolean                        @default(false)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  masterProductId              String?                        @db.Uuid
  cancellableOrderStatuses     String[]                       @default([])
  returnableDays               Int?
  flashDealEnd                 DateTime?                      @db.Timestamp(6)
  offerPrice                   Float?
  flashPrice                   Float?
  agentStockTransferItems      AgentStockTransferItem[]
  bundleItems                  BundleItem[]
  cartItems                    CartItem[]
  ConsumerSubscription         ConsumerSubscription[]
  productCoupons               CouponProduct[]
  cycleCountItems              CycleCountItem[]
  vsmsDamageEntries            DamageEntry[]
  finishedGoods                FinishedGoods[]
  fulfillmentOrderItems        FulfillmentOrderItem[]
  GoodsReceiptItem             GoodsReceiptItem[]
  inventories                  Inventory[]
  inventoryBatches             InventoryBatch[]
  damageEntries                InventoryDamageEntry[]
  inventoryLedgers             InventoryLedger[]
  inventoryMovements           InventoryMovement[]
  reservations                 InventoryReservation[]
  liveStockChannel             LiveStockChannel?
  onlineAppStock               OnlineAppStock?
  workOrders                   WorkOrder[]
  posStoreStock                PosStoreStock?
  preOrderItems                PreOrderItem[]                 @relation("PreOrderItemProduct")
  ProcurementGoodsReceiptItem  ProcurementGoodsReceiptItem[]
  ProcurementStockLedger       ProcurementStockLedger[]
  ProcurementStockTransferItem ProcurementStockTransferItem[]
  brand                        Brand?                         @relation(fields: [brandId], references: [id])
  category                     Category                       @relation(fields: [categoryId], references: [id])
  masterProduct                MasterProduct?                 @relation(fields: [masterProductId], references: [id])
  subCategory                  SubCategory?                   @relation(fields: [subCategoryId], references: [id])
  warehouse                    Warehouse?                     @relation(fields: [warehouseId], references: [id])
  ProductLocation              ProductLocation[]
  prices                       ProductPrice[]
  tierPrices                   ProductTierPrice[]
  variants                     ProductVariant[]
  productionStock              ProductionStock?
  PurchaseInvoiceItem          PurchaseInvoiceItem[]
  PurchaseOrderItem            PurchaseOrderItem[]
  PurchaseRequisitionItem      PurchaseRequisitionItem[]
  ratings                      Rating[]
  recipesAsOutput              Recipe[]                       @relation("RecipeOutput")
  recipeItems                  RecipeItem[]
  refillRequestItems           RefillRequestItem[]
  returnItems                  ReturnItem[]
  sales                        Sales[]
  StockAdjust                  StockAdjust[]
  stockLedgers                 StockLedger[]
  StockTransferItem            StockTransferItem[]
  storeroomStock               StoreroomStock?
  unifiedInventory             UnifiedInventory[]
  orderItems                   OrderItem[]
  vehicleStocks                VehicleStock[]
  vehicleInventory             VehicleInventory[]
  vehicleStockAssignments      VehicleStockAssignment[]
  inventoryAuditLines          InventoryAuditLine[]
  channelInventories           ChannelInventory[]
  VendorItemMapping            VendorItemMapping[]
  demandForecasts              VillageDemandForecast[]
  supplier                     Supplier[]                     @relation("SupplierProducts")

  @@unique([warehouseId, slug])
  @@index([name, warehouseId])
  @@index([categoryId, isActive])
  @@index([brandId, isActive])
  @@index([warehouseId, stock])
  @@index([isActive, isFeatured])
  @@index([sku])
  @@index([barcode])
  @@index([status, isActive])
  @@index([isReturnable, isActive])
  @@index([isCodAllowed, isActive])
  @@index([masterProductId])
  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([subCategoryId])
}

model Rating {
  id        String   @id @default(uuid())
  rating    Float
  review    String?
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Sales {
  id        String   @id @default(uuid())
  productId String
  quantity  Int
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id                String     @id @default(uuid())
  userId            String
  updatedAt         DateTime   @updatedAt
  appliedCouponCode String?
  appliedCouponId   String?    @db.Uuid
  cgst              Float      @default(0)
  igst              Float      @default(0)
  sgst              Float      @default(0)
  taxAmount         Float      @default(0)
  taxableAmount     Float      @default(0)
  expiresAt         DateTime?
  warehouseId       String
  appliedCoupon     Coupon?    @relation(fields: [appliedCouponId], references: [id])
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse         Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items             CartItem[]

  @@unique([userId, warehouseId])
  @@index([appliedCouponId])
  @@index([userId])
  @@index([warehouseId])
}

model CartItem {
  id               String          @id @default(uuid())
  cartId           String
  productId        String
  productVariantId String?
  quantity         Int             @default(1)
  addedAt          DateTime        @default(now())
  priceUpdatedAt   DateTime?
  snapshotPrice    Float?
  bundleId         String?
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productId, productVariantId])
  @@index([cartId])
  @@index([productVariantId])
}

model Order {
