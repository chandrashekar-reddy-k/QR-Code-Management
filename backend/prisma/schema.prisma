  subtitle               String?
  metaDescription        String?
  schemaMarkup           Json?
  subCategoryType        SubCategoryType[]      @default([REGULAR])
  masterProducts         MasterProduct[]
  products               Product[]
  category               Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  warehouseSubCategories WarehouseSubCategory[]

  @@unique([name, categoryId])
  @@index([categoryId, isActive])
}

model Brand {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @db.VarChar(255)
  image          String?
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  priority       Int             @default(0)
  title          String?
  categoryId     String?         @db.Uuid
  subCategoryId  String?         @db.Uuid
  masterProducts MasterProduct[]
  products       Product[]

  @@unique([name, categoryId, subCategoryId])
  @@index([isActive])
  @@index([priority])
  @@index([categoryId])
  @@index([subCategoryId])
}

model Coupon {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String             @db.VarChar(255)
  title              String?            @db.VarChar(255)
  description        String?
  type               String             @db.VarChar(50)
  value              Float
  maxDiscount        Float?
  minOrderValue      Float?
  startDate          DateTime
  expiryDate         DateTime
  isActive           Boolean            @default(true)
  scope              String?            @db.VarChar(50)
  warehouseId        String?
  applicablePincodes String[]           @default([])
  newUserOnly        Boolean            @default(false)
  firstOrderOnly     Boolean            @default(false)
  maxUsesPerUser     Int?
  maxTotalUses       Int?
  totalUses          Int                @default(0)
  termsUrl           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  endTime            String?            @db.VarChar(20)
  startTime          String?            @db.VarChar(20)
  campaigns          Campaign[]
  cartApplications   Cart[]
  warehouse          Warehouse?         @relation(fields: [warehouseId], references: [id])
  products           CouponProduct[]
  redemptions        CouponRedemption[]
  orders             Order[]
  userAssignments    UserCoupon[]

  @@unique([code, warehouseId])
  @@index([code])
  @@index([isActive, startDate, expiryDate])
  @@index([warehouseId])
}

model CouponProduct {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId   String   @db.Uuid
  productId  String
  offerPrice Float?
  roleName   String?  @default("CUSTOMER")
  title      String?
  subTitle   String?
  titleType  String?  @default("SHOP_MORE_UNLOCK_MORE")
  icon       String?
  linkPath   String?  @default("/coupons")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([couponId])
  @@index([productId])
  @@index([roleName, isActive])
}

model AppSectionConfig {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleType    String   @unique
  title        String
  subTitle     String?
  roleName     String   @default("CUSTOMER")
  icon         String?
  linkPath     String?  @default("/coupons")
  displayOrder Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([roleName, isActive])
  @@index([titleType, isActive])
}

model CouponRedemption {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  couponId  String   @db.Uuid
  orderId   String
  discount  Float
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId, orderId])
  @@index([userId, couponId])
  @@index([orderId])
}

model UserCoupon {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String
  couponId   String    @db.Uuid
  assignedAt DateTime  @default(now())
  usedAt     DateTime?
  expiresAt  DateTime?
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
  @@index([userId, usedAt])
}

model Return {
  id              String       @id @default(uuid())
  orderId         String
  orderItemId     String?
  userId          String
  status          ReturnStatus @default(PENDING)
  reason          String?
  notes           String?
  refundAmount    Float
  refundMethod    String?
  refundedAt      DateTime?
  requestedAt     DateTime     @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem       OrderItem?   @relation(fields: [orderItemId], references: [id])
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([orderId])
  @@index([status, requestedAt])
}

model Wishlist {
